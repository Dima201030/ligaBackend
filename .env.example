# HTTP
HTTP_ADDR=0.0.0.0:8080
APP_ENV=development

# Postgres (compose service hostname: db)
DATABASE_URL=postgres://liga:liga@db:5432/liga?sslmode=disable

# 32 raw bytes, base64-encoded (generate: openssl rand -base64 32)
APP_ENCRYPTION_KEY=

# Session cookie: Secure defaults to true when APP_ENV=production
# COOKIE_SECURE=false

# Optional hard gate: block login until email is confirmed (default false).
# Product default is soft: allow login, show banner, block sensitive actions.
# REQUIRE_EMAIL_VERIFICATION=false

# API base (fallback confirm link when FRONT_BASE_URL is unset)
# PUBLIC_BASE_URL=http://127.0.0.1:3020

# Next.js UI origin for confirm-email / reset-password links in outbox (preferred)
# FRONT_BASE_URL=https://tournaments.pairly.space

# Optional SMTP — without it, messages stay in email_outbox (pending).
# Required for mailworker: SMTP_HOST + SMTP_FROM. USER/PASSWORD for authenticated SMTP.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
# Mail worker (compose profile "smtp"):
#   COMPOSE_PROFILES=jobs,smtp
#   docker compose --profile smtp up -d mailworker
# MAIL_POLL_SECONDS=15
# MAIL_BATCH_SIZE=20

# Multi-club tenant (default for X-Club-Slug / ?club= when omitted)
# DEFAULT_CLUB_SLUG=mr-pushkin

# Uploads (covers/avatars) — local disk
# UPLOADS_DIR=./data/uploads
# MAX_UPLOAD_BYTES=5242880

# Nightly rankings snapshot (compose profile "jobs")
# On Pi set COMPOSE_PROFILES=jobs (rankingsnapshot). Add ,smtp when SMTP_* is filled.
# COMPOSE_PROFILES=jobs
# COMPOSE_PROFILES=jobs,smtp
# RANKING_SNAPSHOT_TZ=Europe/Moscow
# RANKING_SNAPSHOT_AT=03:30
# RANKING_SEASON=2026
# RANKING_SNAPSHOT_ONCE=1
# RANKING_SNAPSHOT_FORCE=0

# Seed CLI (go run ./cmd/seed) — never commit real values
# SEED_ORGANIZER_EMAIL=organizer@example.com
# SEED_ORGANIZER_PASSWORD=
# SEED_ORGANIZER_FIRST_NAME=Ирина
# SEED_ORGANIZER_LAST_NAME=Волкова
