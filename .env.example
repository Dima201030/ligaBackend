# HTTP
HTTP_ADDR=0.0.0.0:8080
APP_ENV=development

# Postgres (compose service hostname: db)
DATABASE_URL=postgres://liga:liga@db:5432/liga?sslmode=disable

# 32 raw bytes, base64-encoded (generate: openssl rand -base64 32)
APP_ENCRYPTION_KEY=

# Session cookie: Secure defaults to true when APP_ENV=production
# COOKIE_SECURE=false

# Require verified email before login (default false for local)
# REQUIRE_EMAIL_VERIFICATION=false

# Used in confirm-email links written to email_outbox payload
# PUBLIC_BASE_URL=http://127.0.0.1:3020

# Optional SMTP — without it, messages stay in email_outbox
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
# Mail worker (compose profile "smtp"): docker compose --profile smtp up -d mailworker
# MAIL_POLL_SECONDS=15
# MAIL_BATCH_SIZE=20

# Uploads (covers/avatars) — local disk
# UPLOADS_DIR=./data/uploads
# MAX_UPLOAD_BYTES=5242880

# Seed CLI (go run ./cmd/seed) — never commit real values
# SEED_ORGANIZER_EMAIL=organizer@example.com
# SEED_ORGANIZER_PASSWORD=
# SEED_ORGANIZER_FIRST_NAME=Ирина
# SEED_ORGANIZER_LAST_NAME=Волкова
