[Unit]
Description=Mr. Pushkin League API stack (db, api, rankingsnapshot)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
User=dima
Group=dima
WorkingDirectory=/home/dima/ligaBackend
Environment=COMPOSE_PROFILES=jobs
ExecStart=/usr/bin/docker compose --profile jobs up -d
ExecStop=/usr/bin/docker compose stop
TimeoutStartSec=180

[Install]
WantedBy=multi-user.target
